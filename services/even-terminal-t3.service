[Unit]
Description=Even Terminal (T3 Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/even-terminal/t3.environment
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
ExecStart=%h/.local/share/mise/shims/node %h/.local/lib/even-terminal-adapters/adapters/t3-code/bridge.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
