{
  "name": "even-terminal-adapters",
  "version": "1.0.0",
  "description": "Even Terminal adapters for OpenCode and T3 Code",
  "scripts": {
    "start:opencode": "node adapters/opencode/bridge.mjs",
    "start:t3": "node adapters/t3-code/bridge.mjs",
    "test": "node --test adapters/*/test/*.test.mjs shared/test/*.test.mjs",
    "test:opencode": "node --test adapters/opencode/test/*.test.mjs shared/test/*.test.mjs",
    "test:t3": "node --test adapters/t3-code/test/*.test.mjs shared/test/*.test.mjs",
    "check": "for file in adapters/*/*.mjs adapters/*/test/*.mjs shared/*.mjs shared/test/*.mjs; do node --check \"$file\" || exit; done"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
